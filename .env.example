# =============================================================================
# ChronoDesk — Governança ZDT & Espelhamento GitHub Project #3 / #4
# Arquivo de Exemplo de Variáveis de Ambiente (.env.example)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Banco de Dados — Neon.com Serverless PostgreSQL
# -----------------------------------------------------------------------------
# String de conexão Pooled do Neon.com (Console Neon -> Connect -> Pooled connection)
# Formato: postgresql://<usuario>:<senha>@<endpoint>-pooler.<regiao>.aws.neon.tech/<banco>?sslmode=require
NEON_DATABASE_URL="postgresql://neondb_owner:SUA_SENHA_AQUI@ep-exemplo-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Alias opcional compatível com clientes/ORMs PostgreSQL padrão
DATABASE_URL="postgresql://neondb_owner:SUA_SENHA_AQUI@ep-exemplo-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# -----------------------------------------------------------------------------
# 2. Integração GitHub — API GraphQL / REST & Projects V2
# -----------------------------------------------------------------------------
# Personal Access Token (Classic ou Fine-Grained) com escopos: repo, project, read:org
GITHUB_TOKEN="ghp_SEU_GITHUB_TOKEN_AQUI"

# Segredo opcional para validação de assinatura HMAC (X-Hub-Signature-256) nos Webhooks
GITHUB_WEBHOOK_SECRET="whsec_chronodesk_zdt_secret"

# Repositório padrão monitorado para Issues e Chamados
GITHUB_DEFAULT_REPO="zdttech-copilot/governanca-zdt"

# IDs dos Quadros GitHub Project V2 sincronizados bidirecionalmente
GITHUB_PERSONAL_PROJECT_ID="PVT_kwHOCCI68s4Bn8S0"
GITHUB_PERSONAL_PROJECT_URL="https://github.com/users/felipeolio/projects/3"
GITHUB_ORG_PROJECT_ID="PVT_kwDODck7Fs4Bg-wJ"
GITHUB_ORG_PROJECT_URL="https://github.com/orgs/zdttech-copilot/projects/4"

# -----------------------------------------------------------------------------
# 3. Configurações de Servidor & Ambiente AI Studio / Cloud Run
# -----------------------------------------------------------------------------
# Porta do servidor Express + Vite (Padrão obrigatório: 3000)
PORT="3000"
NODE_ENV="development"

# URL pública onde a aplicação está hospedada (injetada automaticamente em produção)
APP_URL="http://localhost:3000"

# Chave da API Gemini (injetada automaticamente pelo AI Studio quando necessário)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
